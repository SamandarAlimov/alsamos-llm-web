# ===== Alsamos LLM — LOKAL ishlab chiqish sozlamalari =====
# Bu faylni backend/.env deb nusxalang.

# Matn modellari uchun bepul kalit (rasm generatsiya kalitsiz ishlaydi):
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Server (lokal)
ALSAMOS_HOST=127.0.0.1
ALSAMOS_PORT=8000
ALSAMOS_ENV=development

# Agent
ALSAMOS_ENABLE_TOOLS=true
ALSAMOS_ALLOW_EXTERNAL_NET=true

# --- Ixtiyoriy: kirish himoyasi (lokalda odatda bo'sh) ---
ALSAMOS_ACCESS_PASSWORD=
ALSAMOS_SECRET_KEY=
# Integratsiya sinovi uchun API kalit(lar):
ALSAMOS_API_KEYS=
