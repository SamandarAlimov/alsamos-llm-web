# ===== Alsamos LLM — PRODUCTION (Oracle Cloud) sozlamalari =====
# Nusxa oling:  cp backend/.env.production.example backend/.env

# Matn modellari uchun bepul kalit (MAJBURIY): https://openrouter.ai/keys
# (Rasm generatsiya kalitsiz ham ishlaydi.)
OPENROUTER_API_KEY=

# --- Server ---
ALSAMOS_HOST=0.0.0.0
ALSAMOS_PORT=8000
ALSAMOS_ENV=production
ALSAMOS_PUBLIC_URL=https://ai.alsamos.com
ALSAMOS_ALLOWED_ORIGINS=https://ai.alsamos.com

# --- Agent ---
ALSAMOS_ENABLE_TOOLS=true
ALSAMOS_ALLOW_EXTERNAL_NET=true

# --- Xavfsizlik ---
# Saytga kirish paroli (bo'sh bo'lsa — hamma kira oladi). Tavsiya: to'ldiring.
ALSAMOS_ACCESS_PASSWORD=
# 64-belgili maxfiy kalit. oracle-setup.sh buni avtomatik to'ldiradi,
# yoki qo'lda:  openssl rand -hex 32
ALSAMOS_SECRET_KEY=
# Boshqa Alsamos platformalari integratsiyasi uchun API kalit(lar), vergul bilan:
ALSAMOS_API_KEYS=

# --- Ishlash ---
WEB_CONCURRENCY=2
